{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.dev/contracts/events/run-status-changed-v1.schema.json",
  "title": "AgentForge Run Status Changed Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "details"],
  "properties": {
    "status": {
      "enum": [
        "QUEUED",
        "PROVISIONING",
        "RUNNING",
        "VERIFYING",
        "PACKAGING",
        "SUCCEEDED",
        "FAILED",
        "TIMEOUT",
        "CANCELLED"
      ]
    },
    "agent": { "type": ["string", "null"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "details": { "type": "object" }
  }
}
